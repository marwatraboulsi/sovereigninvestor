# Copy this to .env and fill in your values
# Never commit .env to version control

# Claude proxy — points to the Cloudflare Worker (no timeout on streaming).
# Falls back to the Supabase Edge Function if not set.
EXPO_PUBLIC_CLAUDE_PROXY_URL=https://sovereign-claude-proxy.mtraboulsi01.workers.dev

# Anthropic API key is no longer needed in the app — it lives in the Cloudflare Worker secret vault.
# EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here

EXPO_PUBLIC_SERP_API_KEY=your_serp_api_key_here
